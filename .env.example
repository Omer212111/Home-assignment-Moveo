# Copy this file to .env in the project folder (next to pyproject.toml). .env is git-ignored.
ANTHROPIC_API_KEY=
# Model used by the agent (default: claude-sonnet-5-5)
LLM_MODEL=claude-sonnet-5-5
# Thinking effort (default: low) and thinking summary for the "Agent steps" view (summarized | omitted)
LLM_EFFORT=low
LLM_THINKING_DISPLAY=summarized
# Optional: raw API cache in Redis instead of data/raw/ files
# REDIS_URL=redis://localhost:6379/0
# Optional: paid Open-Meteo key (the free tier is for non-commercial use only)
OPEN_METEO_API_KEY=
# Optional: alerts are POSTed here (Slack-compatible JSON); without it they are stored and shown in the page
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Optional: token required by POST /alerts/check (header X-Alerts-Token)
# ALERTS_TOKEN=
# Optional, for a public URL: the whole site asks for this password (any user name), except /health
# APP_PASSWORD=
